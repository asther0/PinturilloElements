# Portal SDK publishable API key (safe for browser bundles)
NEXT_PUBLIC_PORTAL_API_KEY=

# Optional: room id suffix (defaults to 'demo')
NEXT_PUBLIC_ROOM_ID=demo

# --- Supabase (browser-safe) ---
# Supabase project URL (safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable anon key (safe for browser bundles)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-only) ---
# Supabase secret key (server-side only; keep out of browser bundles)
SUPABASE_SECRET_KEY=
# Supabase service role key (server-side only; bypasses RLS - keep secret)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase direct database connection string (server-side only)
SUPABASE_DB_URL=
